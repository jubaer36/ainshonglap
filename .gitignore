# Raw legal-document corpus: large binaries, reproducible from Laws/SOURCES.md.
# Laws/main/ is the exception — the three acts actually ingested, plus their
# parsed JSON, are tracked so the pipeline's input and output are reviewable.
# Note: git will not descend into an ignored directory, so the directory itself
# has to be un-ignored before anything inside it can be.
Laws/*
!Laws/*.md
!Laws/main/

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Editors
.vscode/*
!.vscode/extensions.json
.idea/

# Env files (never commit secrets/local config)
.env
.env.*
!.env.example

# Logs
*.log

# --- frontend/ (Next.js) ---
frontend/node_modules
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions
frontend/coverage
frontend/.next/
frontend/out/
frontend/build
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
frontend/.vercel
*.tsbuildinfo
frontend/next-env.d.ts

# --- backend/ (Python/FastAPI) ---
backend/.venv/
__pycache__/
*.pyc
*.egg-info/

# Parser scratch output
backend/scripts/*_out/

# Regenerable retrieval caches: intermediate scoring passes that experiments
# write so an interrupted run resumes. Large, derived, and reproducible from the
# index — unlike the *_results.json files, which are the measured findings that
# experiments.md cites and are tracked deliberately.
Laws/main/index/abstention_ctx_k*.json
Laws/main/index/threshold_scores_k*.json
Laws/main/index/refine_cache_*.json



sample.html