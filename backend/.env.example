# Copy to .env.local and fill in. Never commit .env.local.
# Keep comments on their own lines: Docker's --env-file reads a trailing
# "# ..." as part of the value.

# ---------------------------------------------------------------- required
# Groq, for answers and image reading
GROQ_API_KEY=
# OpenRouter, for search (nemotron-3-embed)
OPENROUTER_API_KEY=
# Supabase -> Project Settings -> API. The service key is server-only:
# never put it in the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- optional
# More Groq keys, used in turn (_4, _5 ... also work)
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# Own keys for the planner, conversation memory, and the fallback model
GROQ_API_KEY_PLANNER=
GROQ_API_KEY_SUMMARIZER=
GROQ_API_KEY_FALLBACK=
# A second OpenRouter key, used in turn with the first
OPENROUTER_API_KEY_2=
# Names conversations
GEMINI_API_KEY_3=
# Extra selectable models
GEMINI_API_KEY=
INCEPTION_API_KEY=
# Voice input
DEEPGRAM_API_KEY=
# Who can add and remove sources (comma-separated emails)
ADMIN_EMAILS=

# ---------------------------------------------------------------- settings
# Default answer model
RAG_GENERATOR=oss120
# Search: nemotron-embed, or nemotron-embed+rerank (a second request per question)
RAG_RETRIEVAL=nemotron-embed
# Private Supabase bucket for page images
SUPABASE_BUCKET=page-images
# Only for old Supabase projects with a legacy JWT secret
SUPABASE_JWT_SECRET=
# CORS_ORIGINS=http://localhost:3000
