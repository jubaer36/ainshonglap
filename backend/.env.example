# Generators: gpt-oss-120b (default) and the other Groq routes, rotated across
# every numbered key. _2, _3, ... are optional and discovered automatically.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
RAG_GENERATOR=oss120

# One key per job that runs on every question, outside that rotation.
GROQ_API_KEY_PLANNER=
GROQ_API_KEY_SUMMARIZER=
# The system-wide fallback (gpt-oss-120b) for every model call that fails.
GROQ_API_KEY_FALLBACK=
# Conversation naming, and nothing else.
GEMINI_API_KEY_3=

# Optional: selectable generators, voice, vision, old router.
GEMINI_API_KEY=
INCEPTION_API_KEY=
OPENROUTER_API_KEY=
DEEPGRAM_API_KEY=
RAG_ROUTER_MODEL=lfm

# Signed-in emails allowed to add/remove sources from the frontend.
ADMIN_EMAILS=

# Comma-separated. localhost and 127.0.0.1 are distinct origins to the browser.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------- Supabase
# Project Settings -> API, in the Supabase dashboard.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security completely. It belongs
# ONLY here, in the gitignored server-side file. It must never appear in
# frontend/.env.local, in any NEXT_PUBLIC_ variable, or in the repository —
# anything holding it can read and delete every user's data.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# OPTIONAL, and usually blank. Project Settings -> JWT Keys.
#
# New Supabase projects sign tokens with ASYMMETRIC keys, and the API verifies
# those against the project's public JWKS endpoint — nothing to copy here. Only
# older projects have a shared HS256 secret, shown under a "Legacy JWT Secret"
# tab; paste it here if your project still has one. The verifier reads the
# token's `alg` header and picks the right method either way.
SUPABASE_JWT_SECRET=
# Storage bucket for page images (create it as a PRIVATE bucket).
SUPABASE_BUCKET=page-images
